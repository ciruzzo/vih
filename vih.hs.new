import EditBuffer
import Rendering
import Input
import Data.Char
import System.Environment (getArgs)
import System.Console.Terminal.Size (size, height)

data EditMode = Command | Insert deriving (Eq,Show)

sata Session = Session
  { filePath :: FilePath
  , extent   :: Int
  } deriving (Show)

data Editor = Editor
  { edMode    :: EditMode
  , edSession :: Session
  , edBuffer  :: EditBuffer
  } deriving (Show)

-- 1キーで完結する純粋コマンドの表
keyActions :: [(Char, EditBuffer -> EditBuffer)]
keyActions =
  [ ('h', moveLeft),   ('j', moveDown),  ('k', moveUp),  ('l', moveRight)
  , ('w', wordForward),('b', wordBackward)
  , ('G', moveToEnd),  ('0', moveToLineStart), ('$', moveToLineEnd)
  ]

main :: IO ()
main =
  do dims <- size
     let yExt = min 40 ((maybe 33 height dims) - 2)
     initInput
     args <- getArgs
     let base = Editor Command (Session "" yExt) (EditBuffer 0 (0,0) "")
     case args of
       [f] -> do contents <- readFile f
                 mainLoop base { edSession = (edSession base) { filePath = f }
                               , edBuffer  = EditBuffer 0 (0,0) contents }
       _   -> mainLoop base

mainLoop :: Editor -> IO ()
mainLoop ed =
  do cls
     let y = extent (edSession ed)
     render y (frame y (edBuffer ed))
     ch <- getInputChar
     next <- dispatch ch ed
     case next of
       Nothing  -> return ()          -- 終了
       Just ed2 -> mainLoop ed2       -- ← 呼び出しはこの1箇所だけ

-- 1文字 → 次の状態。終了したら Nothing
dispatch :: Char -> Editor -> IO (Maybe Editor)
dispatch ch ed
  | edMode ed == Insert =
      case ch of
        '\ESC'           -> return (Just ed { edMode = Command })
        c | isInputChar c -> return (Just ed { edBuffer = insertChar c (edBuffer ed) })
        _                -> return (Just ed)
  | otherwise =
      case lookup ch keyActions of
        Just act -> return (Just ed { edBuffer = act (edBuffer ed) })
        _        -> case ch of
          ':' -> do s <- promptAndRead ":" (extent (edSession ed))
                    handleCommand ed s
          '/' -> do s <- promptAndRead "/" (extent (edSession ed))
                    return (Just ed { edBuffer = searchForward s (edBuffer ed) })
          'i' -> return (Just ed { edMode = Insert })
          'o' -> return (Just ed { edMode    = Insert
                                 , edBuffer  = insertLineAfter (edBuffer ed) })
          'x' -> return (Just ed { edBuffer = deleteChar (edBuffer ed) })
          'd' -> secondKey $ \_ -> Just ed { edBuffer = deleteLine (edBuffer ed) }
          'g' -> secondKey $ \_ -> Just ed { edBuffer = moveToHome (edBuffer ed) }
          'r' -> secondKey $ \c2 ->
                   if isInputChar c2
                     then Just ed { edBuffer = replaceChar c2 (edBuffer ed) }
                     else Just ed
          _   -> return (Just ed)

-- 2キー目を1文字読む小ヘルパ(d/g/r 共通の形状)
secondKey :: (Char -> Maybe Editor) -> IO (Maybe Editor)
secondKey k = do c <- getInputChar
                 return (k c)

promptAndRead :: String -> Int -> IO String
promptAndRead p y =
  do goto (commandHome y)
     putStr p
     getLine

handleCommand :: Editor -> String -> IO (Maybe Editor)
handleCommand ed cmd =
  do goto (commandHome y)
     putStr ":"
     case cmd of
       ('q':_)                -> return Nothing
       ("wq") | not (null fp) -> do writeFile fp (getBufferContents b)
                                    return Nothing
       ('w':_) | not (null fp)-> do writeFile fp (getBufferContents b)
                                   return (Just ed)
       (c:_)  | isDigit c     -> return (Just ed { edBuffer =
                                moveToLine (read cmd :: Int) b })
       _                      -> return (Just ed)
  where y  = extent (edSession ed)
        fp = filePath (edSession ed)
        b  = edBuffer ed

isInputChar :: Char -> Bool
isInputChar ch = (not (isControl ch)) || (ch == '\n')
